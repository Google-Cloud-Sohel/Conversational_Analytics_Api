# Copy to .env and fill in. Nothing here is secret.

# --- Vertex AI ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
AGENT_MODEL=gemini-2.5-flash

# --- MCP Toolbox + BigQuery (all three are REQUIRED) ---
# agent.py reads these with os.environ[...], so a missing value raises
# KeyError at import time — before the agent starts.
# TOOLBOX_URL is the Cloud Run service deployed from "MCP Toolbox/tools.yaml".
TOOLBOX_URL=https://your-toolbox-service-url.a.run.app
BQ_DATASET=your_bq_dataset
BQ_TABLE=your_bq_table

# --- Deployment only (not read by agent.py) ---
AGENT_URL=https://your-agent-service-url.a.run.app

# --- Service account key: REQUIRED for local runs, remove when deploying ---
# The agent uses CredentialStrategy.workload_identity(), which looks for the
# GCP metadata server. Off Google Cloud there isn't one, so every tool call
# waits ~12s for 169.254.169.254, times out, and falls back — roughly 12
# seconds of dead time per call.
#
# Point this at a key for a service account holding roles/run.invoker on the
# Toolbox service:
#   gcloud run services add-iam-policy-binding toolbox --region=us-central1 \
#     --member="serviceAccount:YOUR_SA@PROJECT.iam.gserviceaccount.com" \
#     --role="roles/run.invoker"
#
# Without run.invoker the calls are rejected and the agent returns empty
# responses while still generating correct SQL — a confusing failure.
# On Cloud Run, delete this line: the metadata server handles it in ms.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account-key.json