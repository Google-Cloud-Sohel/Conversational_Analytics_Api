# Copy to .env and fill in. Nothing here is secret.
#
# This agent reaches the Conversational Analytics Data Agent through
# Application Default Credentials, so run this once:
#   gcloud auth application-default login
#
# Do NOT set GOOGLE_APPLICATION_CREDENTIALS here. The service account used by
# ecom_mcp_agent lacks roles/geminidataanalytics.dataAgentUser, so pointing
# this agent at that key breaks every tool call.

# --- Read by the agent at runtime ---
# GOOGLE_CLOUD_PROJECT is the only one agent.py reads directly; the other two
# are consumed by ADK to route model calls through Vertex AI.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- Deployment only (not read by agent.py) ---
AGENT_PATH=./ecom_agent
SERVICE_NAME=ecom-orders-agent
ECOM_AGENT_SERVICE_URL=https://your-agent-service-url.a.run.app
APP_NAME=ecom_agent

# NOTE: the Data Agent itself (name and location) is hard-coded in agent.py as
# DATA_AGENT_ID / DATA_AGENT_LOCATION, not configured here. It is created by
# create_data_agent.py.